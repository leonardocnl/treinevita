# Copy to .env.local and fill in. Never commit real values.
# Production (Vercel) requires every variable below; the app refuses to start otherwise.
# Locally they are all optional: without DATABASE_URL the app uses the PGlite database.

# Neon (Postgres) connection string. The Vercel Neon integration sets it, plus
# DATABASE_URL_UNPOOLED, which the deploy migrations prefer.
DATABASE_URL=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign in (MVP: owner only). Case-insensitive.
ALLOWED_EMAILS=

# Public base URL of the app; the OAuth callback is ${APP_URL}/api/auth/google/callback
APP_URL=http://localhost:3005
