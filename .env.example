# Copy to .env.local and fill in. Never commit real values.

# Neon (Postgres) connection string for the VITA project only
DATABASE_URL=

# Google OAuth client (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of emails allowed to sign in (MVP: owner only)
ALLOWED_EMAILS=

# Random 32+ byte secret used to sign session cookies
SESSION_SECRET=

# Public base URL of the app (used for OAuth callbacks)
APP_URL=http://localhost:3000
