{
    "name": "treinevita",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "check:format": "prettier --check .",
        "check:types": "tsc --noEmit",
        "check:architecture": "depcruise src --config .dependency-cruiser.cjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "prepare": "lefthook install || true",
        "db:local:reset": "tsx scripts/db-local-reset.ts",
        "db:migrate:deploy": "tsx scripts/migrate.ts",
        "db:seed:catalog": "tsx scripts/seed-catalog.ts",
        "catalog:import-drawings": "tsx scripts/import-everkinetic.ts"
    },
    "dependencies": {
        "@electric-sql/pglite": "^0.5.15",
        "@neondatabase/serverless": "^1.2.0",
        "arctic": "^3.7.0",
        "drizzle-orm": "^0.45.4",
        "motion": "^14.10.1",
        "next": "16.4.5",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "server-only": "^0.0.1",
        "uuidv7": "^1.2.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^22.20.5",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dependency-cruiser": "^18.7.2",
        "dotenv": "^18.0.9",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9",
        "eslint-config-next": "16.4.5",
        "lefthook": "^2.2.2",
        "prettier": "^3.9.10",
        "sharp": "0.35.5",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=22"
    }
}
